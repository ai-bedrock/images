// The deploy user may start the image update for one image (image-update@<name>.service), and
// nothing else; the unit checks the name against the host's list again.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "deploy" &&
        action.lookup("verb") == "start" &&
        /^image-update@[a-z0-9][a-z0-9-]*(\.[a-z0-9][a-z0-9-]*)*\.service$/.test(action.lookup("unit"))) {
        return polkit.Result.YES;
    }
});
